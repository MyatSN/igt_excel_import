<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="igt_excel_import_config_form" model="ir.ui.view">
            <field name="name">igt.excel.import.form</field>
            <field name="model">igt.excel.import</field>
            <field name="arch" type="xml">
                <form string="Excel Import Configs">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,published"/>
                        <button name="action_publish" type="object" string="Publish" states="draft" class="btn-primary"/>
                        <button name="action_unpublish" type="object" string="Unpublish" states="published" class="btn-default"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Reference"/>
                        </h1>
                    </div>
                        <group>
                            <group>
                                <field name="model_id"/>
                                <field name="child_model_id"/>
                                <field name="parent_field_id"/>
                                <field name="import_field_id"/>
                            </group>
                            <group>
                                <field name="model_name" invisible="1"/>
                                <field name="child_model_name" invisible="1"/>
                                <field name="sample_file" filename="sample_filename"/>
                                <field name="sample_filename" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                           <page string="Column Mapping">
                               <field name="line_ids">
                                   <tree>
                                       <field name="model_name" invisible="1"/>
                                       <field name="column_name"/>
                                       <field name="field_id"/>
                                       <field name="domain"/>
                                   </tree>
                               </field>
                           </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
    </record>
    <record id="igt_excel_import_config_tree" model="ir.ui.view">
            <field name="name">igt.excel.import.tree</field>
            <field name="model">igt.excel.import</field>
            <field name="arch" type="xml">
                <tree string="Excel Import Configs">
                    <field name="name"/>
                    <field name="model_id"/>
                </tree>
            </field>
    </record>
    <record id="action_igt_excel_import_config" model="ir.actions.act_window">
        <field name="name">Excel Import Configs</field>
        <field name="res_model">igt.excel.import</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="igt_excel_import_config_tree"/>
    </record>

    <!-- Menu -->
    <menuitem id="menu_igt_root" name="XLSX Setting" sequence="1000" web_icon="igt_excel_import,static/images/icon.jpg"/>
    <menuitem id="menu_igt_excel_import" name="Excel Imports"
              parent="menu_igt_root" action="action_igt_excel_import_config"
              groups="base.group_system"/>

</odoo>
